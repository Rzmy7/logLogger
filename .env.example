# ==============================================================================
# Log Platform Environment Configuration Example
# Copy this file to .env and adjust values for your local or cloud environment.
# ==============================================================================

# PostgreSQL Connection String (Metadata & Service Registry)
POSTGRES_URL=postgresql://postgres:password@localhost:5432/log_analytics?sslmode=disable

# Redis Connection URL (Supports local redis:// and TLS-enabled Upstash rediss://)
REDIS_URL=redis://localhost:6379

# Kafka Broker Addresses (Comma-separated)
KAFKA_BROKERS=localhost:9092

# Elasticsearch Cluster Base URL
ELASTICSEARCH_URL=http://localhost:9200

# Service Port Configurations
HTTP_PORT=8081                     # Ingestor HTTP port
ANALYTICS_PORT=8082                # Analytics REST API port
PROCESSOR_METRICS_PORT=8083        # Processor Prometheus metrics & health port

# Application Logging Level (debug, info, warn, error)
LOG_LEVEL=info
